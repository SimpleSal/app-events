// -------------------------------------------------------------------------------------------------
// The Statistics Events FSM both calculates statistics and emits them to the plotter, periodically.
// The calculation occurs periodically; the current value is the result of the last calculation.
// The emission to the plotter occurs periodically; the value emitted is the current value.
// -------------------------------------------------------------------------------------------------
// WHEN statistics are emitted, EITHER a table of stats is displayed, or, signals are "plottered".
// The tables of numbers are useful when things are not working; the graphs show things are working.
// -------------------------------------------------------------------------------------------------
void    App_CalcStats (void);
void    App_EmitStats (void);

ssE_EvResult_t App_StatsEvent_Operate (ssE_pAboutEvVoid_t param1, ssT_pTime_t pCurrentTime)
{
#ifdef DEBUG_STATSEVENT_TIME
    // F14B24: debug output hard faults if assignment to the pEvApi is not made first (below)
    StatsEvent_pEvApi = ssUI_dbOp_Lookup_UsingEvApi_i (STATSevent_EVENT_API);
#endif // DEBUG_STATSEVENT_TIME

    boolean             CalcPeriod_Completed = false;
    boolean             EmitPeriod_Completed = false;

    ssUI_db_pEvApi_t    StatsEvent_pEvApi;
    ssE_EvResult_t      ReturnResult = ssE_EvResult_OK_go;

    if (param1 == pVoidEvParam1Null)
    {
        App_Announce_Event ("App_StatsEvent_Operate in init state...");
        return (ReturnResult);
    }

#ifdef APP_ONEOF_SHOW_STATS
#ifdef APP_OPTIN_ANNOUNCE_EVENT
    ss_uiOp_Show_Time (pCurrentTime, lfN);
    App_Announce_Event ("   App_StatsEvent_Operate in Agencying state...");
#endif  // APP_OPTIN_ANNOUNCE_EVENT
#endif  // APP_ONEOF_SHOW_STATS

    // ---------------------------------------------------------------------------------------------
    // This countdown algorithm creates a legacy Timekeeping model, based on this Event's period.
    // A countdown timer or a countup timer is an FSM with an Initial state of "# times to count 1"
    // (where 0 means "don't count"). The algorithm for each is specific; this is a countdown timer.
    // ---------------------------------------------------------------------------------------------
    // This countdown timer algorithm decrements what it knows to be a positive integer.  Countdown
    // algorithms may signal an FSM for action when the result of the decrement operation is zero.
    // The value of the countdown after the action is taken is also a function of the algorithm.
    // ---------------------------------------------------------------------------------------------
    StatsEvent_pEvApi = ssUI_dbOp_Lookup_UsingEvApi_i (STATSevent_EVENT_API);
    if (StatsEvent_pEvApi->App_EventData.Stats_CalcPeriod_ct > 0)
    {
        // when the signal changes from nonzero to zero, calculate the statistics
        --StatsEvent_pEvApi->App_EventData.Stats_CalcPeriod_ct;
        if (StatsEvent_pEvApi->App_EventData.Stats_CalcPeriod_ct == 0)
        {
            StatsEvent_pEvApi->App_EventData.Stats_CalcPeriod_ct =
                    StatsEvent_pEvApi->App_EventData.Stats_CalcPeriod_ms;
            CalcPeriod_Completed = true;
        }
    }   // not displaying stats using a countdown timer

    if (StatsEvent_pEvApi->App_EventData.Stats_EmitPeriod_ct > 0)
    {
        // when the signal changes from nonzero to zero, display the statistics
        --StatsEvent_pEvApi->App_EventData.Stats_EmitPeriod_ct;
        if (StatsEvent_pEvApi->App_EventData.Stats_EmitPeriod_ct == 0)
        {
            StatsEvent_pEvApi->App_EventData.Stats_EmitPeriod_ct =
                    StatsEvent_pEvApi->App_EventData.Stats_EmitPeriod_ms;
            EmitPeriod_Completed = true;
        }
    }   // not displaying stats using a countdown timer

    if (CalcPeriod_Completed)
    {
#ifdef APP_ONEOF_PLOT_STATS
        App_CalcStats ();
#endif  // APP_ONEOF_PLOT_STATS
    }   // time to send it

    if (EmitPeriod_Completed)
    {
#ifdef APP_ONEOF_SHOW_STATS
        // ----------------------------------------------------------------------------------------
        // Function called is what would be found and invoked by the menu FSM: "ss agency stats".
        // Actually skipped fake input and just lied to the function: 3 tokens matched by the FSM.
        // ----------------------------------------------------------------------------------------
        if (H_ss_AgencyStats (ssUI_tkn3rd_i, false) != eH_rHandled)
        {
            return (ssE_EvResult_OK_stopMe);
        }
#ifdef DEBUG_STATSEVENT_TIME
        // F14B24: debug output hard faults if assignment to the pEvApi is not made first
        ssUI_dbOp_Show_OneEvApi (StatsEvent_pEvApi);
#endif // DEBUG_STATSEVENT_TIME
#endif  // APP_ONEOF_SHOW_STATS

#ifdef APP_ONEOF_PLOT_STATS
        App_PlotStats ();
#endif  // APP_ONEOF_PLOT_STATS
    }   // time to send it

    return (ReturnResult);
}   // App_StatsEvent_Operate
