// -------------------------------------------------------------------------------------------------
// Statistics proliferate and propagate and regenerate.  Easier: have generic variables always
// allocated here and named here, and then, when a statistic becomes interesting, #define a usage.
// -------------------------------------------------------------------------------------------------
#define last_AgencyingToPaused_ct   Stats_int_1
#define last_PausedToAgencying_ct   Stats_int_2
#define last_AgencyGranted_ct       Stats_int_3

ssA_All_Stats_t         AllEvs_All_Stats;
ssA_All_Stats_t         ThisEv_All_Stats;

// -------------------------------------------------------------------------------------------------
// -------------------------------------------------------------------------------------------------
void    App_CalcStats (void)
{
    ssUI_db_pEvApi_t        pEvApi;
    int                     EvApi_i;

    ssA_statOp_All_Zero (&AllEvs_All_Stats);

    for (EvApi_i = 0; EvApi_i <= SSUI_EVAPI_ALLOC_MAX_I; EvApi_i++)
    {
        pEvApi = ssUI_dbOp_Lookup_UsingEvApi_i (EvApi_i);
        if (!pEvApi->accessOn)
        {
            continue;
        }
        if (pEvApi->pssTEA_ApiSig->Apifsm_state == ssA_Apifsm_state_off)
        {
            continue;
        }
        if (EvApi_i == STATSevent_EVENT_API)            // only include Time and Data Events
        {
            continue;
        }

        ssA_statOp_All_Zero (&ThisEv_All_Stats);

        if (ssUI_apiSignalOp_Emit (pEvApi, ss_ApiSigMsgValue_AgApifsm_Stats))
        {
            if (pEvApi->pssTEA_ApiSig->pApiSigData != pApiSigDataNull)
            {
                ssA_statOp_Apifsm_P1getsP2
                    (
                        &ThisEv_All_Stats.Apifsm,
                        (ssA_pApifsm_Stats_t) pEvApi->pssTEA_ApiSig->pApiSigData
                    );
            }
        }   // Api signal for ApiFsm stats

        if (ssUI_apiSignalOp_Emit (pEvApi, ss_ApiSigMsgValue_AgRunfsm_Stats))
        {
            if (pEvApi->pssTEA_ApiSig->pApiSigData != pApiSigDataNull)
            {
                ssA_statOp_Runfsm_P1getsP2
                    (
                        &ThisEv_All_Stats.Runfsm,
                        (ssA_pRunfsm_Stats_t) pEvApi->pssTEA_ApiSig->pApiSigData
                    );
            }   // params pointer is non-NULL
        }   // if Runfsm stats signal worked

        ssA_statOp_Apifsm_P1getsP1plusP2 (&AllEvs_All_Stats.Apifsm, &ThisEv_All_Stats.Apifsm);
        ssA_statOp_Runfsm_P1getsP1plusP2 (&AllEvs_All_Stats.Runfsm, &ThisEv_All_Stats.Runfsm);
    }   // for
}   // App_CalcStats
// -------------------------------------------------------------------------------------------------
// At a Time in the Future, this function will become a general-purpose plotter output Time Event;
// abstracted down to "the last value for this", "the current value for this", and "name of this".
// -------------------------------------------------------------------------------------------------
int     last_GNT    = 0;
int     last_P2A    = 0;
int     last_A2P    = 0;

void    App_PlotStats (void)
{
    static  int     PlotClock = 0;
    pAscii_t        pClockValue;
    int             temp;

    temp = AllEvs_All_Stats.Runfsm.EvEx.AgencyGranted_ct - last_GNT;
    mesa_uiOp_emit_qAsciiA ("GNT:");
    mesa_uiOp_emit_Int_999 (temp);
    mesa_uiOp_emit_newline ();
    last_GNT = AllEvs_All_Stats.Runfsm.EvEx.AgencyGranted_ct;

    temp =  AllEvs_All_Stats.Runfsm.App.PausedToAgencying_ct - last_P2A;
    mesa_uiOp_emit_qAsciiA ("P2A:");
    mesa_uiOp_emit_Int_999 (temp);
    mesa_uiOp_emit_newline ();
    last_P2A = AllEvs_All_Stats.Runfsm.App.PausedToAgencying_ct;

    temp =  AllEvs_All_Stats.Runfsm.App.AgencyingToPaused_ct - last_A2P;
    mesa_uiOp_emit_qAsciiA ("A2P:");
    mesa_uiOp_emit_Int_999 (temp);
    mesa_uiOp_emit_newline ();
    last_A2P = AllEvs_All_Stats.Runfsm.App.AgencyingToPaused_ct;

    mesa_uiOp_emit_qAsciiA ("CLK:");
    PlotClock   = (PlotClock == 0) ? 1 : 0;
    pClockValue = (PlotClock == 0) ? S("-1") : S("0");
    mesa_uiOp_emit_pAsciiA (pClockValue);
    mesa_uiOp_emit_newline ();

}   // App_PlotStats
