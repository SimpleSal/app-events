#define APP_BUFFER_ALLOC  100
#define APP_BUFFER_MAX_I  (APP_BUFFER_ALLOC-1)

// =================================================================================================
// -------------------------------------------------------------------------------------------------
// The function is owned by the App and specific to the App.  Co-existence with ssTEA starts here.
// For example, configure events and start Time and Agency in support of the App's use of ssTEA.
// The starting position is determined by values is ssTEA_control, as set by App during setup.
// This is the software that will be added to an arduino project to incorporate ssTEA and ssUI.
// -------------------------------------------------------------------------------------------------
void App_ss_launch (void)
{
    AsciiA_t    localBuff[APP_BUFFER_ALLOC];

    ssTEA_control.Time_state = ssTEA_state_stopped;
    ssTEA_control.Time_base = ssTEA_Time_base_reality;
    ssTEA_control.Agency_state = ssTEA_state_stopped;
    ssTEA_control.Agency_pace = ssTEA_Agency_pace_period;
    ssTEA_control.Agency_period = ssTEA_Agency_pace_period_minimum;

    ssTEA_control.Show_Path = false;
    ssTEA_control.Show_Cause = false;
    ssTEA_control.Show_Signals = false;
    ssTEA_control.Show_Notes = false;

    // if a hard fault occurs in ssTEA, the serial output may not get a chance to send it all
    mesa_uiOp_emit_qAsciiA ("<ssTEA init...");
    ssTEA_InitState ();
    mesa_uiOp_emit_qAsciiA ("success>");
    mesa_uiOp_emit_newline ();

    mesa_uiOp_emit_qAsciiA ("<ssUI init...");
    ssUI_InitState ();
    mesa_uiOp_emit_qAsciiA ((ssUI_control.BeVerbose) ? "{verbose, even loquacious}" : "{quiet}");
    mesa_uiOp_emit_qAsciiA ("success>");
    mesa_uiOp_emit_newline ();

    // ---------------------------------------------------------------------------------------------
    // This function is build-controlled: whether it has content or not depends on build options.
    // ---------------------------------------------------------------------------------------------
    App_BuildOp_Show_Build ();

    // ---------------------------------------------------------------------------------------------
    // App is ready for App_loop to run; ssTEA is configured  ready for ssTEA_loop: "hello, world".
    // ---------------------------------------------------------------------------------------------
    if (ssT_stampOp_TimeOfBuild_AsciiToTime (localBuff))
    {
        mesa_uiOp_emit_qAsciiA ("Time built:");
        ss_uiOp_Show_Time (ssT_gpTime_Built, lfY);
    }
#ifdef APP_ONEOF_CLOCK_OR_TIMER_IS_CLOCK
    ssT_mathOp_P1getsP2 (ssT_gpTime_Current, ssT_gpTime_Built);
#endif // APP_ONEOF_CLOCK_OR_TIMER_IS_CLOCK

    // ---------------------------------------------------------------------------------------------
    // The ssTEA Api and Run FSMs are active; now activate the events within that ecosystem.
    // ---------------------------------------------------------------------------------------------
    App_EventLauncher ();

} // App_ss_launch
