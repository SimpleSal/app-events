int     iterations = 0;

void    AppLoop_ssTEA_Interface (void)
{
    ssUI_db_pEvApi_t    pEvApi;
    boolean             bItIsTime_ToStopAgency;     // any path sets a valid value

#ifdef APP_OPTIN_ANNOUNCE_EVENT
    App_Announce_Event ("------" );
    App_Announce_Event ("User loop turned LED On at N*1 second Time boundary.");
    ss_uiOp_Show_Time (ssT_gpTime_Current, lfY);
#endif  // APP_OPTIN_ANNOUNCE_EVENT

    // ---------------------------------------------------------------------------------------------
    // What the "app-events.ino" does: WHEN the LED is turned On (here), a Time period starts
    // during which the LED will be On.  When that period ends, the LED will be turned off.
    // The Time at which the Event is based on software setting OccursAt to "Current + period"
    // AND signaling the Time Event to resume; this causes the Time Event to participate.
    // When the Time Event is granted Agency, it will set the LED to Off and then pause again.
    // ---------------------------------------------------------------------------------------------
    // When the ssUI variable ssUI_gpTimeA has a value of zero, Time Event occurs immediately.
    // When the variable is non-zero, the Time Event occurs at the end of a Duty Cycle Period.
    // ---------------------------------------------------------------------------------------------
    pEvApi = ssUI_dbOp_Lookup_UsingEvApi_i (TIME_EVENT_EVAPI);
    debug_Show_OneEvApi (pEvApi);

    ssT_mathOp_P1getsP2 (&pEvApi->pssTEA_ApiSig->ssE_pAboutEv->OccursAt, ssT_gpTime_Current);
    ssT_mathOp_P1getsP1plusP2 (&pEvApi->pssTEA_ApiSig->ssE_pAboutEv->OccursAt,
                                App_Cycle_DutyCyclePeriod);
#ifdef APP_OPTIN_ANNOUNCE_EVENT
    App_Announce_Event ("Off Event scheduled @");
    ss_uiOp_Show_Time (&pEvApi->pssTEA_ApiSig->ssE_pAboutEv->OccursAt, lfY);
#endif  // APP_OPTIN_ANNOUNCE_EVENT

    // assert: there is no path through this switch that does not set bItIsTime_ToStopAgency
    switch (pEvApi->pssTEA_ApiSig->ssE_pAboutEv->Runfsm_state)
    {
        case ssA_Runfsm_State_stopped   :
            bItIsTime_ToStopAgency = true;
            App_Announce_Event ("Stopped Time Event, an error.");
            break;
        case ssA_Runfsm_State_paused    :
            if (!ssUI_apiSignalOp_Emit (pEvApi, ss_ApiSigMsgValue_AgRunfsm_Resume))
            {
                bItIsTime_ToStopAgency = true;
                App_Announce_Event ("Paused Time Event did not Resume, an error.");
            }
            else
            {
                bItIsTime_ToStopAgency = false;
                App_Announce_Event ("Paused Time Event resumed, not an error.");
            }
            break;
        case ssA_Runfsm_State_agencying :
            bItIsTime_ToStopAgency = false;
            App_Announce_Event ("Agencying Time Event is not paused, not an error.");
            break;
        case ssA_Runfsm_State_flaw      :
            bItIsTime_ToStopAgency = true;
            App_Announce_Event ("Agencying Time Event state is flawed, an error.");
            break;
        default :
            bItIsTime_ToStopAgency = true;
            App_Announce_Event ("Agencying Time Event state is invalid, an error.");
            break;
    }   // switch on RunFSM state

    // ---------------------------------------------------------------------------------------------
    // this is a debug tool: the Ascii terminal program moves the cursor when debug values are
    // displayed: if the complete recording of Ascii output up to now is interesting, stop Agency.
    // No other parts of the App know about this; every participant gates activity on Agency running.
    // ---------------------------------------------------------------------------------------------
    if (iterations > 0)
    {
        --iterations;
        if (iterations == 0)            // only the transition from nonzero to zero stops agency
        {
            bItIsTime_ToStopAgency = true;
        }
    }

    if (bItIsTime_ToStopAgency)
    {
        ssTEA_control.Agency_state = ssTEA_state_stopped;
    }
}   // AppLoop_ssTEA_Interface
