// -------------------------------------------------------------------------------------------------
// This encapsulates the definition and launching within ssTEA of the Time Event and the Data Event.
// -------------------------------------------------------------------------------------------------
ssE_EvResult_t App_EventLauncher (void)
{
    ssUI_db_pEvApi_t    TimeEvent_pEvApi;
    ssUI_db_pEvApi_t    DataEvent_pEvApi;
    ssE_EvResult_t      EvResult;

    App_Announce_Event ("App_EventLauncher: Time Event and Data Event");

    TimeEvent_pEvApi = ssUI_dbOp_Lookup_UsingEvApi_i (TIME_EVENT_EVAPI);
    debug_Show_OneEvApi (TimeEvent_pEvApi);
    DataEvent_pEvApi = ssUI_dbOp_Lookup_UsingEvApi_i (DATA_EVENT_EVAPI);
    debug_Show_OneEvApi (DataEvent_pEvApi);

    EvResult = App_TimeEvent_Define (TimeEvent_pEvApi);
    debug_Show_OneEvApi (TimeEvent_pEvApi);
    if (EvResult != ssE_EvResult_OK_go)
    {
        App_Announce_App ("Time Event Define error; App Launcher failed");
        return (EvResult);
    }

    EvResult = App_DataEvent_Define (DataEvent_pEvApi);
    debug_Show_OneEvApi (DataEvent_pEvApi);
    if (EvResult != ssE_EvResult_OK_go)
    {
        App_Announce_App ("Data Event Define error; App Launcher failed");
        return (EvResult);
    }

    EvResult = App_TimeEvent_Launch (TimeEvent_pEvApi);
    debug_Show_OneEvApi (TimeEvent_pEvApi);
    if (EvResult != ssE_EvResult_OK_go)
    {
        App_Announce_App ("Time Launch failed");
        return (EvResult);
    }

    EvResult = App_DataEvent_Launch (DataEvent_pEvApi);
    debug_Show_OneEvApi (DataEvent_pEvApi);
    if (EvResult != ssE_EvResult_OK_go)
    {
        App_Announce_App ("Time Launch OK, Data Launch failed");
        return (EvResult);
    }

    App_Announce_App ("Time and Data Launch OK; App Launch success");
    return (EvResult);
}   // App_EventLauncher
