#endif  // APP_ONEOF_CLOCK_OR_TIMER_IS_TIMER

#ifdef APP_ONEOF_CLOCK_OR_TIMER_IS_CLOCK
ReadOnly    pAsciiA_t   pcMsg_InitBanner    = S("Clock App using Events initializing ssTEA...");
