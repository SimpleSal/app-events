// =================================================================================================
// -------------------------------------------------------------------------------------------------
// "App_loop" is the original Arduino App's "loop" function, which will now be granted agency
// by ssTEA's "loop".  This was done by a #define trick in this file: rename the original App "loop"
// to "App_loop" and rename "ssTEA_loop" to "loop".  The result is the linker sees two functions:
// "App_loop" and "loop".  Instructions may be found elsewhere describing how to modify Original App.
// -------------------------------------------------------------------------------------------------
// This function should be usable as-is and used as-is.  This is where Time is perceived by ssTEA.
// When Agency granted by the Host OS has been intercepted here, Agency is granted first to ssTEA
// to manage Events, and finally Agency is granted to the App to react to the Events that occured.
// -------------------------------------------------------------------------------------------------
// ssTEA computes the consumption of Time by App Events inside ssTEA and by the App outside ssTEA.
// Because ssTEA bases all knowledge of Time on us_gLoop1toLoop2, software here that lies about the
// number of microseconds could basically make the entire ssTEA-based application into a Time-based
// simulation of the Time environment the algorithm interacts with.  Or something along those lines.
// -------------------------------------------------------------------------------------------------
#define ssTEA_loop loop

void ssTEA_loop (void)
{
    ssTEA_Time_MathEntry ();

    ssTEA_Agency_Root (ssT_us_gLoop1toLoop2, ssT_ms_gLoop1toLoop2);

    ssTEA_Time_MathExit ();

    App_loop ();

} // ssTEA_loop

#undef ssTEA_loop       // don't forget to forget #define

// the ssHL compiler has seen and compiled "App_loop" and "loop"

