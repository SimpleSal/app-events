// -------------------------------------------------------------------------------------------------
// Statistics proliferate and propagate and regenerate.  Easier: have generic variables always
// allocated here and named here, and then, when a statistic becomes interesting, #define a usage.
// -------------------------------------------------------------------------------------------------
int         Stats_int_1;
int         Stats_int_2;
int         Stats_int_3;
int         Stats_int_4;

ssE_EvResult_t App_StatsEvent_Define (ssUI_db_pEvApi_t pEvApi)
{
    ssTEA_pApiSig_t         pApiSig;
    ssE_pAboutEv_t          ssE_pAboutEv;
    ssUI_db_pEvApi_t        TimeEvent_pEvApi;

    pEvApi->pEvApiNameTkn_App = &myStatsEventTkn;

    App_Announce_App (pcMsg_AgApifsm_OnReq);
    if (!ssUI_apiSignalOp_Emit (pEvApi, ss_ApiSigMsgValue_AgApifsm_On))
    {
        App_Announce_ssTEA ("Request to set Stats Event Agency API FSM state to On failed, an error.");
        return (ssE_EvResult_notOK_state);
    }

    pApiSig = pEvApi->pssTEA_ApiSig;
    ssE_pAboutEv = pApiSig->ssE_pAboutEv;

    ssE_pAboutEv->pEvFunc = &App_StatsEvent_Operate;
    ssE_pAboutEv->Runfsm_EvType = ssE_EvType_Time;

    // use the OccursAt start Time value set by the Time Event (for itself) for Stats start Time
    TimeEvent_pEvApi = ssUI_dbOp_Lookup_UsingEvApi_i (TIMEevent_EVENT_API);
    ssT_mathOp_P1getsP2 (&ssE_pAboutEv->OccursAt,
                         &TimeEvent_pEvApi->pssTEA_ApiSig->ssE_pAboutEv->OccursAt);

    ssE_pAboutEv->recurs = true;
    ssE_pAboutEv->recursFromTrue = true;
    ssT_mathOp_P1getsP2 (&ssE_pAboutEv->Period, App_pStats_Period_Emit);

#ifdef DEBUG_STATSEVENT_TIME
    ssUI_dbOp_Show_OneEvApi (pEvApi);                                   // F14B17 debug
#endif // DEBUG_STATSEVENT_TIME

    ssE_pAboutEv->App_pEventData = (EvEx_App_pEventData_t) &pEvApi->App_EventData;
    pEvApi->App_EventData.Stats_CalcPeriod_ms = App_CalcPeriod;
    pEvApi->App_EventData.Stats_CalcPeriod_ct = pEvApi->App_EventData.Stats_CalcPeriod_ms;
    pEvApi->App_EventData.Stats_EmitPeriod_ms = App_EmitPeriod;
    pEvApi->App_EventData.Stats_EmitPeriod_ct = pEvApi->App_EventData.Stats_EmitPeriod_ms;

    Stats_int_1 = Stats_int_2 = Stats_int_3 = Stats_int_4 = 0;

    App_Announce_App ("Stats Event Agency API On; Stats Event Defined");

    return (ssE_EvResult_OK_go);
}  // App_StatsEvent_Define
