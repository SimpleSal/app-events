// -------------------------------------------------------------------------------------------------
// This function must be instantiated by the App in order to satisfy ssUI's reference when the
// App is built, but the function does not have to do anything with the user input provided.
// -------------------------------------------------------------------------------------------------
void App_HeyProcessThis (pAsciiA_t  pReceivedInput)
{
    mesa_uiOp_emit_newline ();
    ss_uiOp_emit_lbld_AsciiA (S("App's command input processor called with:"), pReceivedInput);

    if (ssUI_BufferOnlyHas_appui (pReceivedInput))
    {
        // -----------------------------------------------------------------------------------------
        // agency has been granted by ssTEA_App to the App to control the Ascii UI.
        // ssTEA_App is comprised of the Apps and the ssUI interface used to manipulate the Apps and ssTEA
        // -----------------------------------------------------------------------------------------
        ss_uiOp_qBanner (lfN, "App will now control the UI", lfY);
        mesa_Ascii_RO_state = mesa_RO_state_App;
    }
    else
    {
        // -----------------------------------------------------------------------------------------
        // agency has been granted by the App to ssUI to control the UI
        // -----------------------------------------------------------------------------------------
        if (ssUI_BufferOnlyHas_ssui (pReceivedInput))
        {
            mesa_Ascii_RO_state = mesa_RO_state_SimpleSal;
        }
    }
} // App_HeyProcessThis

