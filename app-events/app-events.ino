ReadOnly pAsciiA_t  pcDataEvent             = S("DataEvent");
ssUI_Token_t        myDataEventTkn          = { pcDataEvent     , 9, NoBananas };

ssE_EvResult_t App_DataEvent_Define (ssUI_db_pEvApi_t pEvApi)
{
    ssTEA_pApiSig_t         pApiSig;                // create a local expression for an object within
    ssE_pAboutEv_t          ssE_pAboutEv;           // same

    ssE_EvResult_t          EvResult = ssE_EvResult_OK_go;

    pEvApi->pEvApiNameTkn_App = &myDataEventTkn;

    App_Announce_App ("Data Event Launcher Api FSM On Request");
    if (!ssUI_apiSignalOp_Emit (pEvApi, ss_ApiSigMsgValue_AgApifsm_On))
    {
        App_Announce_App ("Request to set Data Event API FSM state to On failed.");
        return (ssE_EvResult_notOK_state);
    }

    pApiSig = pEvApi->pssTEA_ApiSig;
    ssE_pAboutEv = pApiSig->ssE_pAboutEv;

    // ---------------------------------------------------------------------------------------------
    // Everything about a Data Event's data is defined by the Data Event: format, location, alloc.
    // ---------------------------------------------------------------------------------------------
    // This is where the concept of pointers to code is used: assign an address to a variable.
    // ---------------------------------------------------------------------------------------------
    ssE_pAboutEv->pEvFunc = &App_DataEvent_Operate;
    ssE_pAboutEv->Runfsm_EvType = ssE_EvType_Data;
    ssE_pAboutEv->App_pEventData = (EvEx_App_pEventData_t) &pEvApi->App_EventData;

    App_Announce_App ("Data Event Agency API On; DataEvent Defined");
    return (EvResult);
}  // App_DataEvent_Define
