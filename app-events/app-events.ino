// -------------------------------------------------------------------------------------------------
// This defines an Event FSM in the language ssTEA uses to manage an Event within an operating FSM.
// -------------------------------------------------------------------------------------------------
ReadOnly pAsciiA_t  pcTimeEvent             = S("TimeEvent");
ssUI_Token_t        myTimeEventTkn          = { pcTimeEvent     , 9, NoBananas };

ssE_EvResult_t App_TimeEvent_Define (ssUI_db_pEvApi_t pEvApi)
{
    ssTEA_pApiSig_t         pApiSig;                // create local expressions for an object within
    ssE_pAboutEv_t          ssE_pAboutEv;           //   the EvApi data pointed to by the caller

    ssE_EvResult_t          EvResult = ssE_EvResult_OK_go;

    // ---------------------------------------------------------------------------------------------
    // NOTE: ssUI's free supply of EvApi data has initialization for some fields that need updating
    // ---------------------------------------------------------------------------------------------
    pEvApi->pEvApiNameTkn_App = &myTimeEventTkn;
    pEvApi->pEvFuncToUse = &App_TimeEvent_Operate;

    App_Announce_App ("Time Event Launcher Api FSM On Request : ");
    if (!ssUI_apiSignalOp_Emit (pEvApi, ss_ApiSigMsgValue_AgApifsm_On))
    {
        App_Announce_ssTEA ("Request to set Time Event Agency API FSM state to On failed, an error.");
        return (ssE_EvResult_notOK_state);
    }

    // ---------------------------------------------------------------------------------------------
    // The signal carrier for the Event API to ssTEA has a pointer to the ssTEA data About the Event.
    // Change focus to ssTEA's view of or about the event.  We know our App is trusted, as chosen
    // by the Simplest Config, we know the pointer to the AboutEv was established by ssTEA's Api On.
    // ---------------------------------------------------------------------------------------------
    // NOTE: This complex ssTEA detail matters only when changing from one style to the other.  Later.
    // ---------------------------------------------------------------------------------------------
    // NOTE: This is a result of the design of ssUI supporting N Events inherently for the App to use,
    // NOTE: the pointer must be initialized in the EvApi by the App before the Agency Api FSM is ON.
    // NOTE: A SimpleSal App allocating and managing the EvApi data structures does not need this.
    // ---------------------------------------------------------------------------------------------
    pApiSig = pEvApi->pssTEA_ApiSig;
    ssE_pAboutEv = pApiSig->ssE_pAboutEv;

    // ---------------------------------------------------------------------------------------------
    // The App loop (in this forced example) turns On the LED every N seconds (example: 5 seconds).
    // With the LED On, the App loop changes the OccursAt Time and period and resumes the Time Event.
    // ---------------------------------------------------------------------------------------------
    // The Time Event turns Off the LED when the period of Time completes (example: 3 seconds).
    // The Time Event, while agencying, waits to be granted Agency.  The period between App loop's
    // LED On and Event's LED Off is the period of Time "On Duty"; as a percentage "the Duty Cycle".
    // ---------------------------------------------------------------------------------------------
    // Why? An off|on|off cycle repeating has a period On and a period Off; an oscillating signal
    // has a Duty Cycle of 50%.  Power management in SOC chips is based on reducing the Duty cycle
    // (as % of a power signal cycle) down to ONLY that needed, by controlling the power duty cycle.
    // ---------------------------------------------------------------------------------------------
    // NOTE: done by Api FSM On:  pEvApi->pssTEA_ApiSig->ssE_pAboutEv->pEvFunc = pEvApi->pEvFuncToUse;
    // ---------------------------------------------------------------------------------------------
    ssE_pAboutEv->Runfsm_EvType = ssE_EvType_Time;
    ssT_mathOp_P1getsP2 (&ssE_pAboutEv->OccursAt, ssT_gpTime_Current);  // immediate on being resumed
    ssE_pAboutEv->recurs = true;
    ssE_pAboutEv->recursFromTrue = true;
    ssT_mathOp_P1getsP2 (&ssE_pAboutEv->Period, ssT_gpTime_1sc);        // recur each second
    ssE_pAboutEv->App_pEventData = (EvEx_App_pEventData_t) &pEvApi->App_EventData;

    App_Announce_App ("Time Event Agency API On; TimeEvent Defined");
    App_Announce_App ("Event Occurs At ");
    ss_uiOp_Show_Time (&ssE_pAboutEv->OccursAt, lfY);

    return (EvResult);
}  // App_TimeEvent_Define
// -------------------------------------------------------------------------------------------------
// This "launch the App Event into ssTEA's FSM control", using the definition created by the App.
// -------------------------------------------------------------------------------------------------
ssE_EvResult_t App_TimeEvent_Launch (ssUI_db_pEvApi_t pEvApi)
{
    ssE_EvResult_t  EvResult = App_Launch_in_ssTEA (pEvApi);

    // ---------------------------------------------------------------------------------------------
    // A Launched Time Event is by definition in the Agencying state.  The NEXT moment in Time the
    // Launched Time Event COULD be granted Agency by ssTEA is the NEXT moment in Time Agency is
    // granted to ssTEA by the App's loop, and the Event is considered and granted Agency by ssTEA.
    // ---------------------------------------------------------------------------------------------
    // For the purposes of this (forced) example, and to make the reader think about Time, a flawed
    // Time Event model is forced.  Normal use of Time Events is to OccurAt one or both transitions;
    // the Period for these transitions remains constant so the Event simply recurs in ssTEA's view.
    // Also forced is the Event's request on exit to be returned to the Paused state from Agencying.
    // ---------------------------------------------------------------------------------------------
    if (EvResult == ssE_EvResult_OK_go)
    {
        if (ssUI_apiSignalOp_Emit (pEvApi, ss_ApiSigMsgValue_AgRunfsm_Pause))
        {
            App_Announce_ssTEA ("Agencying Time Event paused");
        }   // Pause succeeded
        else
        {   // Pause failed
            App_Announce_ssTEA ("Error: Agency Api FSM failed to pause while Agencying");
            EvResult = ssE_EvResult_notOK_API;
        }   // Pause failed
    }   // Launch in ssTEA succeeded
    else
    {   // Launch in ssTEA failed
        App_Announce_ssTEA ("Error: Agency Api FSM Launch failed");
    }   // Launch in ssTEA failed

    return (EvResult);
}  // App_TimeEvent_Launch
// -------------------------------------------------------------------------------------------------
// The content here that is ssTEA-related software: 1) makes sure not init state; 2) return Pause.
// The content that is App-related software: 1) signal Data Event with data; turn the LED off.
// -------------------------------------------------------------------------------------------------
// Note that this Event does not refer to About Event data of its own, but that of the Data Event.
// -------------------------------------------------------------------------------------------------
ssE_EvResult_t App_TimeEvent_Operate (ssE_pAboutEvVoid_t param1, ssT_pTime_t pCurrentTime)
{
    ssUI_db_pEvApi_t    DataEvent_pEvApi;
    ssE_EvResult_t      ReturnResult = ssE_EvResult_OK_go;

    if (param1 == pVoidEvParam1Null)
    {
        App_Announce_Event ("App_TimeEvent_Operate in init state...");
        return (ReturnResult);
    }

    mesa_uiOp_LEDoff ();
#ifdef APP_OPTIN_ANNOUNCE_EVENT
    ss_uiOp_Show_Time (ssT_gpTime_Current, lfY);
    App_Announce_Event ("App_TimeEvent_Operate in agency state turned LED off...");
    App_Announce_Event ("App_TimeEvent_Operate in agency state sending msg to Data Event...");
#endif  // APP_OPTIN_ANNOUNCE_EVENT

    // ---------------------------------------------------------------------------------------------
    // One method for communicating between the App's context and the Event's context is to simply
    // refer to variables within the scope or view of the software: global to the App and the Event.
    // In this case, the global variable is the space allocated for this Event by the App in EvApi.
    // ---------------------------------------------------------------------------------------------
    DataEvent_pEvApi = ssUI_dbOp_Lookup_UsingEvApi_i (DATA_EVENT_EVAPI);
    (void) ssUI_AaOp_pP1_gets_pP2max (&DataEvent_pEvApi->App_EventData.Data[0],
                   S("msg from Time Event: LED turned off...1234567890"), APP_DATA_MAX_I);

    // ---------------------------------------------------------------------------------------------
    // The Time Event sends a signal to ssTEA to resume the Data Event, using the Data Event's API.
    // ---------------------------------------------------------------------------------------------
    if (!ssUI_apiSignalOp_Emit (DataEvent_pEvApi, ss_ApiSigMsgValue_AgRunfsm_Resume))
    {
        App_Announce_ssTEA ("attempt to signal Data Event resume by LED Off failed");
        return (ssE_EvResult_notOK_state);
    }

    ReturnResult = ssE_EvResult_OK_pauseMe;
    return (ReturnResult);
}   // App_TimeEvent_Operate
