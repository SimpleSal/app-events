#define     App_Duty_OnTime         ssT_gpTime_3sc
#define     App_Duty_OffTime        ssT_gpTime_2sc

#define     App_StartTimeFromNow    ssT_gpTime_1sc

#define     App_CalcPeriod          50          // frequent calculation means smaller deltas
#define     App_EmitPeriod          500         // slower emission seems to show more variance

