    debug_Show_OneEvApi (TimeEvent_pEvApi);
    DataEvent_pEvApi = ssUI_dbOp_Lookup_UsingEvApi_i (DATAevent_EVENT_API);
    debug_Show_OneEvApi (DataEvent_p );
    StatsEvent_pEvApi = ssUI_dbOp_Lookup_UsingEvApi_i (STATSevent_EVENT_API);
    debug_Show_OneEvApi (StatsEvent_pEvApi);

    App_Announce_App ("  ");        // space a line
