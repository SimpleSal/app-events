#undef  setup

#define setup   App_setup

void setup (void)       // the App's original setup function, ssTEA calls as App_setup.
{
    // this content was in the App's original setup function, copied here before adding SimpleSal
    /* original App */

    // this content added to the App's original setup function, co-existence has a price.
    mesa_Ascii_RO_state     = mesa_RO_state_App;
    mesa_Ascii_RO_substate  = mesa_RO_substate_none;

    mesa_uiOp_deviceInitialize ();

    mesa_uiOp_emit_newline ();
    mesa_uiOp_emit_newline ();
    mesa_uiOp_emit_newline ();
    mesa_uiOp_emit_qAsciiA ("original App setup complete...");
    mesa_uiOp_emit_newline ();

    mesa_gCtOf_1usThis1ms     = 0;      // this App only tries to be active every 1000 milliseconds
    mesa_gCtOf_1msThis100ms   = 0;      // mesa provides for ssUI which is not used here
    mesa_gCtOf_1msThisCycle   = 0;      // period: starting with off->on until the next off->on

    mesa_gCtOf_1msFreeRunning = 0;      // a calculated millis count rather than reading a chip reg

}   // setup            // the App's original setup function

#undef setup            // don't forget to forget #define

// the ssHL compiler has seen and compiled "App_setup", and has not yet seen anything called "setup".

// =================================================================================================
#undef  loop

#define loop    App_loop

void loop (void)        // (the App's original loop function, ssTEA's loop calls as App_loop)
{
    // ---------------------------------------------------------------------------------------------
    // Remember that the Arduino Host OS API calls "loop" and the trick used here puts ssTEA there.
    // ---------------------------------------------------------------------------------------------
    // This is a common Arduino Time Keeping algorithm: watch a microsecond counter change over Time.
    // Within Arduino, the function "micros ()" returns the number of microseconds since Time began.
    // This makes it possible to see how many microseconds occured since we last checked the Time.
    // The number of micros from one loop to the next, "loop1 to loop2", is calculated by ssTEA.
    // ---------------------------------------------------------------------------------------------
    // An App already tracking micros could of course continue to do so here.
    // ---------------------------------------------------------------------------------------------
    mesa_gCtOf_1usThis1ms += ssT_us_gLoop1toLoop2;

    // ---------------------------------------------------------------------------------------------
    // This "gate" the user's loop function (below) to only execute one time each 1000 microseconds.
    // ---------------------------------------------------------------------------------------------
    if (mesa_gCtOf_1usThis1ms <= SST_USECS_PER_MSEC)
    {
        return;
    }
    mesa_gCtOf_1usThis1ms = 0;

    // ---------------------------------------------------------------------------------------------
    // FreeRunning is a 32-bit number.  That number "modulo 1000" creates a remainder.  When the
    // remainder is zero, 1000 milliseconds have passed, or, 1 second.  Math is inherent in the
    // ability of the processor, math is what is was designed to do, math instructions are optimal.
    // ---------------------------------------------------------------------------------------------
    // The method does require the compiler store 32-bit values to compare with, somewhere nearby.
    // ---------------------------------------------------------------------------------------------
    mesa_gCtOf_1msFreeRunning++;
    if ((mesa_gCtOf_1msFreeRunning % SST_MSECS_PER_SEC) == 0)       // make the serial LED blink
    {
        // ssTEA and the App co-exist, so the deeply internal Agency state of ssTEA is easily seen.
        // if ssTEA Time and Agency FSMs are not operating, this App does not attempt to use them.
        if (ssTEA_control.Agency_state == ssTEA_state_running)
        {
            mesa_uiOp_emit_1 (Ascii_ESC);
            if ((mesa_gCtOf_1msFreeRunning % (SST_MSECS_PER_SEC * 20)) == 0)
            {
                mesa_uiOp_emit_newline ();                              // move the display
            }
        }
    }   // the App signal of activity while in loop is the serial port 1 value each 1 second

    // ---------------------------------------------------------------------------------------------
    // The count of millis this Cycle is not Free Running; but in fact the value of the Count is the
    // same value as the remainder that would have been computed based on the Free Running Count.
    // The valid range of values is constrained to the Cycle's millisecond range as decided by the App.
    // Finally, this solution considers any number over a maximum rather than specific maximum values.
    // ---------------------------------------------------------------------------------------------
    mesa_gCtOf_1msThisCycle++;
    if (mesa_gCtOf_1msThisCycle >= 5000)         // 5 1000-millisecond seconds use 5000 milliseconds
    {
        mesa_gCtOf_1msThisCycle = 0;

        // ssTEA and the App co-exist, so the deeply internal Agency state of ssTEA is easily seen.
        // if ssTEA Time and Agency FSMs are not operating, this App does not attempt to use them.
        if (ssTEA_control.Agency_state == ssTEA_state_running)
        {
            // the "events-based App": using a legacy timekeeping method, assert LED On each second.
            mesa_uiOp_LEDon ();

            // Schedule a Time Event in the App to turn the LED Off after a period of Time.
            AppLoop_ssTEA_Interface ();
        }   // ssTEA Agency running means ssTEA Time is running
        else
        {
            mesa_uiOp_LEDoff ();        // pretend it is a large machine, default state is off
        }
    }   // timeout occured
    // 1 millisecond of Time has gone by since we were last here in the algorithm

    // ---------------------------------------------------------------------------------------------
    // Any form of Time Keeping when dealing with humans needs to work at human speed: slowly. See
    // the more sophisticated SimpleSal Apps such as "app-fsmdemo" for examples of human device I/O.
    // This SimpleSal App does not depend on Ascii input received through ssUI so just do the math.
    // While ssTEA does not inherently manage 100ms units, ssUI gates Ascii read attempts to a
    // reasonable period between reads using this Time Keeping value which App_loop must maintain.
    // ---------------------------------------------------------------------------------------------
    mesa_gCtOf_1msThis100ms += 1;
    if (mesa_gCtOf_1msThis100ms >= 100)
    {
        mesa_gCtOf_1msThis100ms = 0;
    }   // 100ms period occured
}   // loop             // the App's original loop function, known as "App_loop"

#undef  loop            // don't forget to forget #define

