        App_Announce_Event ("Data Event definition error");
        App_Announce_App (pcMsg_AppLauncherFailed);
        return (EvResult);
    }

    App_Announce_App ("  ");        // space a line
    App_Announce_App ("-- Stats event launch: define");

    EvResult = App_StatsEvent_Define (StatsEvent_pEvApi);
    debug_Show_OneEvApi (StatsEvent_pEvApi);
    if (EvResult != ssE_EvResult_OK_go)
    {
        App_Announce_Event ("Stats Event definition error");
        App_Announce_App (pcMsg_AppLauncherFailed);
        return (EvResult);
    }

    App_Announce_App ("  ");        // space a line
    App_Announce_App ("-- Time event launch: operate");

    EvResult = App_TimeEvent_Launch (TimeEvent_pEvApi);
    debug_Show_OneEvApi (TimeEvent_pEvApi);
    if (EvResult != ssE_EvResult_OK_go)
    {
        App_Announce_Event ("Time Event Launch attempt failed");
        App_Announce_App (pcMsg_AppLauncherFailed);
        return (EvResult);
    }
    App_Announce_App ("-- Time Event Launched");

    App_Announce_App ("  ");        // space a line
    App_Announce_App ("-- Data event launch: operate");

    EvResult = App_DataEvent_Launch (DataEvent_pEvApi);
    debug_Show_OneEvApi (DataEvent_pEvApi);
    if (EvResult != ssE_EvResult_OK_go)
    {
        App_Announce_Event ("Data Event Launch attempt failed");
        App_Announce_App (pcMsg_AppLauncherFailed);
        return (EvResult);
    }
    App_Announce_App ("-- Data Event Launched");

    App_Announce_App ("  ");        // space a line
    App_Announce_App ("-- Stats event launch: operate");

    EvResult = App_StatsEvent_Launch (StatsEvent_pEvApi);

    debug_Show_OneEvApi (StatsEvent_pEvApi);
    if (EvResult != ssE_EvResult_OK_go)
    {
        App_Announce_Event ("Stats Launch attempt failed");
        App_Announce_App (pcMsg_AppLauncherFailed);
        return (EvResult);
    }
    App_Announce_App ("-- Stats Event Launched");

    App_Announce_App ("  ");        // space a line
    App_Announce_App ("- [Time, Data, Stats] Event Launch attempts complete");

    return (EvResult);
