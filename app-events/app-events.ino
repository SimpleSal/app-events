ssE_EvResult_t App_DataEvent_Launch (ssUI_db_pEvApi_t pEvApi)
{
    ssE_EvResult_t  EvResult = App_Launch_in_ssTEA (pEvApi);

    if (EvResult == ssE_EvResult_OK_go)
    {
        if (ssUI_apiSignalOp_Emit (pEvApi, ss_ApiSigMsgValue_AgRunfsm_Pause))
        {
            App_Announce_ssTEA ("Agencying Data Event paused");
        }   // Pause succeeded
        else
        {   // Pause failed
            App_Announce_ssTEA ("Error: Agency Api FSM failed to pause while Agencying");
            EvResult = ssE_EvResult_notOK_API;
        }   // Pause failed
    }   // launched now agencying

    return (EvResult);
}  // App_DataEvent_Launch
// -------------------------------------------------------------------------------------------------
// The content here that is ssTEA-related software: 1) makes sure not init state; 2) return Pause.
// The content that is App-related software: 1) emit the bytes given to the output device.
// -------------------------------------------------------------------------------------------------
ssE_EvResult_t App_DataEvent_Operate (ssE_pAboutEvVoid_t param1, ssT_pTime_t pCurrentTime)
{
    ssE_pAboutEv_t      ssE_pAboutEv;      // valid after param1 is qualified as non-NULL
    App_pEventData_t    local_App_pEventData;

    ssE_EvResult_t      ReturnResult = ssE_EvResult_OK_pauseMe;

    if (param1 == pVoidEvParam1Null)
    {
        App_Announce_Event ("App_DataEvent_Operate in init state...");
        return (ReturnResult);
    }

    App_Announce_Event ("App_DataEvent_Operate in agency state emits Time Event data...");

    // ---------------------------------------------------------------------------------------------
    // One method for communicating between the App's context and the Event's context is a pointer
    // to the App's data tucked away in the About Event data given to the Event when Agency granted.
    // This supports an Event that is given the information about the device to address by the App.
    // ---------------------------------------------------------------------------------------------
    ssE_pAboutEv = (ssE_pAboutEv_t) param1;
    local_App_pEventData = (App_pEventData_t) ssE_pAboutEv->App_pEventData;
#ifdef APP_OPTIN_ANNOUNCE_EVENT
    App_Announce_Event (&local_App_pEventData->Data);
    ss_uiOp_Show_Time (ssT_gpTime_Current, lfY);
#endif  // APP_OPTIN_ANNOUNCE_EVENT

    ReturnResult = ssE_EvResult_OK_pauseMe;
    return (ReturnResult);
}   // App_DataEvent_Operate
